# Copy to .env (never commit .env)

# Anthropic API: needed from Phase 3. Phases 1–2 make no AI calls.
ANTHROPIC_API_KEY=

# Hard spend cap in USD per Claude classification run (each run stops before any request that could cross it,
# and refuses to start if its estimate exceeds the cap unless you choose "within cap").
# Natural-language requests (~1 cent each) are checked individually and shown under Claude -> Usage.
SIFT_AI_SPEND_CAP_USD=2.00

# Models (verified 2026-11-04). Bulk = first pass over unsettled senders; review = second opinion for
# low-confidence groups and natural-language requests. Leave blank for these defaults.
SIFT_MODEL_BULK=claude-haiku-4-5
SIFT_MODEL_REVIEW=claude-opus-5-5

# Mailbox: "mock" (synthetic, default) or "gmail" (your account, read-only). `./start.sh --gmail` overrides.
SIFT_PROVIDER=mock

# Path to the Google OAuth Desktop client JSON (see docs/google-setup.md after Phase 2)
GOOGLE_CLIENT_SECRETS=~/.sift/client_secret.json

# Safety
SIFT_FIRST_RUN_CAP=50
SIFT_DEMO_MODE=false

# Local ports
SIFT_API_PORT=8765
SIFT_UI_PORT=5173
